# Токен бота от @BotFather
BOT_TOKEN=put-your-token-here

# Ссылка на сайт, которую шлём в дожиме через 24ч
SITE_URL=https://example.com

# Подключение к БД.
# Локально: sqlite+aiosqlite:///./bot.db
# На Railway добавь Postgres-плагин — он сам подставит DATABASE_URL (postgres://...),
# код автоматически перепишет его в postgresql+asyncpg://
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Как часто проверять пользователей для дожима (в секундах). 60 — норм для прода.
FOLLOW_UP_CHECK_INTERVAL=60

# Через сколько секунд после 3-го урока слать дожим. По умолчанию 24 часа.
FOLLOW_UP_DELAY_SECONDS=86400
